PORT=4000
DATABASE_URL=postgres://invente_payment_db:replace-with-password@invente-postgres-dev:5432/invente_payment_db
FRONTEND_ORIGIN=http://localhost:3000
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000

# Firebase — path to service account JSON key file
# Generate at: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=invente-backend
# FIREBASE_SERVICE_ACCOUNT_FILE=./service-account.json
# Alternate: paste the service-account.json as a single line into this var
GOOGLE_APPLICATION_CREDENTIALS=

# JWT (RS256) — if JWT_PUBLIC_KEY is omitted, it is auto-derived from the private key
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Master admin local login (bypasses Firebase)
MASTER_ADMIN_EMAIL=admin@invente.com
MASTER_ADMIN_PASSWORD=changeme

# Logging
LOG_LEVEL=info
LOKI_URL=
LOKI_BASIC_AUTH=
LOG_PRETTY=true
SERVICE_NAME=invente26-admin-backend
